# 必填：DeepSeek API Key；通过 OpenAI-compatible Chat Completions 与 Tool Calling 调用
OPENAI_API_KEY=

# 当前项目使用 DeepSeek endpoint
OPENAI_BASE_URL=https://api.deepseek.com/v1

# 当前项目使用 DeepSeek Chat；必须支持 tool calling
OPENAI_MODEL=deepseek-chat

# 带货功能必填：不配置时陪伴聊天仍可用，商品搜索安全降级
TAVILY_API_KEY=

# 可选：Express 端口
PORT=3001
