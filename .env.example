# 必填：OpenAI-compatible Chat Completions 与 Tool Calling
OPENAI_API_KEY=your_openai_api_key

# 可选：兼容服务地址；例如 DeepSeek/OpenAI-compatible endpoint
OPENAI_BASE_URL=

# 可选：默认 gpt-3.5-turbo；必须支持 tool calling
OPENAI_MODEL=gpt-3.5-turbo

# 带货功能必填：不配置时陪伴聊天仍可用，商品搜索安全降级
TAVILY_API_KEY=your_tavily_api_key

# 可选：Express 端口
PORT=3001
